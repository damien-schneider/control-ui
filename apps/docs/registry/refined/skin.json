{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "skin-refined",
  "type": "registry:theme",
  "title": "Refined skin",
  "description": "Craft-inspired neutral surfaces, Inter typography, pill controls, and quiet layered shadows.",
  "dependencies": [],
  "registryDependencies": [
    "core"
  ],
  "files": [
    {
      "path": "src/registry/skin-packs/refined/skin.config.tsx",
      "target": "@components/control-ui/skin.config.tsx",
      "type": "registry:lib"
    },
    {
      "path": "src/registry/skin-packs/refined/skin.css",
      "target": "@components/control-ui/styles/skin.css",
      "type": "registry:file"
    },
    {
      "path": "src/registry/skin-packs/refined/theme.css",
      "target": "@components/control-ui/styles/skin-theme.css",
      "type": "registry:file"
    }
  ],
  "css": {
    "@import \"../components/control-ui/styles/skin-theme.css\"": {},
    "@import \"../components/control-ui/styles/skin.css\"": {}
  },
  "meta": {
    "sourceManifestPath": "registry/refined/skin.json"
  }
}
