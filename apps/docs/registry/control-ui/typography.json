{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "typography",
  "type": "registry:ui",
  "title": "Typography",
  "description": "Heading and Text over the token-driven type scale: level is the document outline, size is the rung, tone is the color role, className stays layout-only. A bare text-* rung is for markup React doesn't render as components, such as MDX or email HTML.",
  "dependencies": [],
  "registryDependencies": [
    "core"
  ],
  "files": [
    {
      "path": "src/registry/examples/control-ui/primitives/type-scale.css",
      "target": "@components/control-ui/styles/type-scale.css",
      "type": "registry:file"
    },
    {
      "path": "src/registry/sources/control-ui/ui/markdown-heading.ts",
      "target": "@components/control-ui/ui/markdown-heading.ts",
      "type": "registry:ui"
    },
    {
      "path": "src/registry/sources/control-ui/ui/typography.tsx",
      "target": "@components/control-ui/ui/typography.tsx",
      "type": "registry:ui"
    }
  ],
  "css": {
    "@import \"../components/control-ui/styles/type-scale.css\"": {}
  },
  "meta": {
    "sourceManifestPath": "registry/control-ui/typography.json"
  }
}
