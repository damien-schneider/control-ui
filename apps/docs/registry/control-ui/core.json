{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "core",
  "type": "registry:base",
  "title": "Control UI core",
  "description": "Shared contracts, skin resolver, utilities, token bindings, and invariant mechanics for Control UI.",
  "docs": "Components include neutral defaults. Supply your own tokens and an optional SkinProvider to customize the design.",
  "dependencies": [
    "clsx@^2.1.1",
    "tailwind-merge@^3.6.0"
  ],
  "registryDependencies": [],
  "files": [
    {
      "path": "src/registry/lib/cn.ts",
      "target": "@components/control-ui/lib/cn.ts",
      "type": "registry:lib"
    },
    {
      "path": "src/registry/skin-provider.tsx",
      "target": "@components/control-ui/skin-provider.tsx",
      "type": "registry:component"
    },
    {
      "path": "src/registry/skin.ts",
      "target": "@components/control-ui/skin.ts",
      "type": "registry:lib"
    },
    {
      "path": "src/registry/sources/control-ui/control-props.ts",
      "target": "@components/control-ui/control-props.ts",
      "type": "registry:component"
    },
    {
      "path": "src/registry/sources/control-ui/control-variants.ts",
      "target": "@components/control-ui/control-variants.ts",
      "type": "registry:component"
    },
    {
      "path": "src/registry/sources/control-ui/scripts/contrast-eval.mjs",
      "target": "@components/control-ui/scripts/contrast-eval.mjs",
      "type": "registry:file"
    },
    {
      "path": "src/registry/sources/control-ui/scripts/control-ui-doctor.mjs",
      "target": "@components/control-ui/scripts/control-ui-doctor.mjs",
      "type": "registry:file"
    },
    {
      "path": "src/registry/sources/control-ui/scripts/fix-css-imports.mjs",
      "target": "@components/control-ui/scripts/fix-css-imports.mjs",
      "type": "registry:file"
    },
    {
      "path": "src/registry/sources/control-ui/scripts/required-pairs.mjs",
      "target": "@components/control-ui/scripts/required-pairs.mjs",
      "type": "registry:file"
    },
    {
      "path": "src/registry/sources/control-ui/theme.css",
      "target": "@components/control-ui/styles/theme.css",
      "type": "registry:file"
    }
  ],
  "css": {
    "@import \"../components/control-ui/styles/theme.css\"": {}
  },
  "meta": {
    "internal": true,
    "sourceManifestPath": "registry/control-ui/core.json"
  }
}
