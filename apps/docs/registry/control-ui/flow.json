{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "flow",
  "type": "registry:ui",
  "title": "Flow",
  "description": "Node graph editor parts that skin React Flow with Control UI tokens.",
  "dependencies": [
    "@xyflow/react@^12.12.0",
    "lucide-react@^1.47.0"
  ],
  "registryDependencies": [
    "button",
    "canvas-grid",
    "core",
    "motion"
  ],
  "files": [
    {
      "path": "src/registry/knob-contracts/flow-knobs.ts",
      "target": "@components/control-ui/knob-contracts/flow-knobs.ts",
      "type": "registry:component"
    },
    {
      "path": "src/registry/sources/control-ui/recipes/flow.css",
      "target": "@components/control-ui/styles/recipes/flow.css",
      "type": "registry:file"
    },
    {
      "path": "src/registry/sources/control-ui/ui/flow.tsx",
      "target": "@components/control-ui/ui/flow.tsx",
      "type": "registry:ui"
    }
  ],
  "css": {
    "@import \"../components/control-ui/styles/recipes/flow.css\"": {}
  },
  "meta": {
    "sourceManifestPath": "registry/control-ui/flow.json"
  }
}
