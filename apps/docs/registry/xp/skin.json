{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "skin-xp",
  "type": "registry:style",
  "title": "Windows XP skin",
  "description": "Windows XP Luna with compact system typography, glossy controls, blue window frames, and Explorer task panes.",
  "dependencies": [],
  "registryDependencies": [
    "core",
    "effects",
    "retro-system-font"
  ],
  "files": [
    {
      "path": "src/registry/skin-packs/xp/skin.config.tsx",
      "target": "@components/control-ui/skin.config.tsx",
      "type": "registry:lib"
    },
    {
      "path": "src/registry/skin-packs/xp/skin.css",
      "target": "@components/control-ui/styles/skin.css",
      "type": "registry:file"
    },
    {
      "path": "src/registry/skin-packs/xp/theme.css",
      "target": "@components/control-ui/styles/skin-theme.css",
      "type": "registry:file"
    },
    {
      "path": "src/registry/skin-packs/xp/xp-controls.css",
      "target": "@components/control-ui/styles/xp-controls.css",
      "type": "registry:file"
    }
  ],
  "css": {
    "@import \"../components/control-ui/styles/skin-theme.css\"": {},
    "@import \"../components/control-ui/styles/skin.css\"": {},
    "@import \"../components/control-ui/styles/xp-controls.css\"": {}
  },
  "meta": {
    "sourceManifestPath": "registry/xp/skin.json"
  }
}
