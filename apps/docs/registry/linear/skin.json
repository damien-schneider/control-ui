{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "skin-linear",
  "type": "registry:style",
  "title": "Linear skin",
  "description": "Linear-inspired skin: indigo brand on a cool neutral ramp, a flat 13px chrome band, 8px controls on 12px panels, hairline borders instead of elevation, and 8px menu rows inset in a 4px gutter.",
  "dependencies": [],
  "registryDependencies": [
    "core"
  ],
  "files": [
    {
      "path": "src/registry/skin-packs/linear/skin.config.tsx",
      "target": "@components/control-ui/skin.config.tsx",
      "type": "registry:lib"
    },
    {
      "path": "src/registry/skin-packs/linear/skin.css",
      "target": "@components/control-ui/styles/skin.css",
      "type": "registry:file"
    },
    {
      "path": "src/registry/skin-packs/linear/theme.css",
      "target": "@components/control-ui/styles/skin-theme.css",
      "type": "registry:file"
    }
  ],
  "css": {
    "@import \"../components/control-ui/styles/skin-theme.css\"": {},
    "@import \"../components/control-ui/styles/skin.css\"": {}
  },
  "meta": {
    "sourceManifestPath": "registry/linear/skin.json"
  }
}
