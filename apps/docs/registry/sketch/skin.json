{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "skin-sketch",
  "type": "registry:style",
  "title": "Sketch skin",
  "description": "Hand-drawn pencil outlines, Excalifont handwriting, and neutral paper surfaces. A clean sketchbook for prototypes and everyday interfaces.",
  "docs": "Import skin-theme.css and skin.css in your global CSS, then mount <SketchStrokeRuntime /> once in your root layout from \"@/components/control-ui/sketch-stroke-runtime\". Smooth SVG pen strokes follow each control’s dimensions and theme colors, including native inputs. The runtime restores its styles on unmount.",
  "dependencies": [],
  "registryDependencies": [
    "core"
  ],
  "files": [
    {
      "path": "src/registry/skin-packs/sketch/excalifont.css",
      "target": "@components/control-ui/styles/excalifont.css",
      "type": "registry:file"
    },
    {
      "path": "src/registry/skin-packs/sketch/sketch-stroke-runtime.tsx",
      "target": "@components/control-ui/sketch-stroke-runtime.tsx",
      "type": "registry:component"
    },
    {
      "path": "src/registry/skin-packs/sketch/sketch-stroke.ts",
      "target": "@components/control-ui/sketch-stroke.ts",
      "type": "registry:component"
    },
    {
      "path": "src/registry/skin-packs/sketch/skin.config.tsx",
      "target": "@components/control-ui/skin.config.tsx",
      "type": "registry:lib"
    },
    {
      "path": "src/registry/skin-packs/sketch/skin.css",
      "target": "@components/control-ui/styles/skin.css",
      "type": "registry:file"
    },
    {
      "path": "src/registry/skin-packs/sketch/theme.css",
      "target": "@components/control-ui/styles/skin-theme.css",
      "type": "registry:file"
    }
  ],
  "css": {
    "@import \"../components/control-ui/styles/skin-theme.css\"": {},
    "@import \"../components/control-ui/styles/skin.css\"": {},
    "@import \"../components/control-ui/styles/excalifont.css\"": {}
  },
  "meta": {
    "sourceManifestPath": "registry/sketch/skin.json"
  }
}
