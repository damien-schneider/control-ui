{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "skin-modern-apple",
  "type": "registry:style",
  "title": "macOS skin",
  "description": "macOS 27 Liquid Glass: SF Pro at 13px, 24px regular controls, accent-filled selection, frosted glass menus and popovers, and an edge-attached sidebar.",
  "docs": "Import skin-theme.css and skin.css in your global CSS, then mount <ModernAppleGlassFilter /> once in your root layout from \"@/components/control-ui/modern-apple-glass-filter\". This static SVG adds edge refraction in Chromium without client effects or backdrop capture. Other browsers retain native blur and glass rims.",
  "dependencies": [],
  "registryDependencies": [
    "core"
  ],
  "files": [
    {
      "path": "src/registry/skin-packs/modern-apple/modern-apple-controls.css",
      "target": "@components/control-ui/styles/modern-apple-controls.css",
      "type": "registry:file"
    },
    {
      "path": "src/registry/skin-packs/modern-apple/modern-apple-glass-filter.tsx",
      "target": "@components/control-ui/modern-apple-glass-filter.tsx",
      "type": "registry:component"
    },
    {
      "path": "src/registry/skin-packs/modern-apple/modern-apple-surfaces.css",
      "target": "@components/control-ui/styles/modern-apple-surfaces.css",
      "type": "registry:file"
    },
    {
      "path": "src/registry/skin-packs/modern-apple/skin.config.tsx",
      "target": "@components/control-ui/skin.config.tsx",
      "type": "registry:lib"
    },
    {
      "path": "src/registry/skin-packs/modern-apple/skin.css",
      "target": "@components/control-ui/styles/skin.css",
      "type": "registry:file"
    },
    {
      "path": "src/registry/skin-packs/modern-apple/theme.css",
      "target": "@components/control-ui/styles/skin-theme.css",
      "type": "registry:file"
    }
  ],
  "css": {
    "@import \"../components/control-ui/styles/skin-theme.css\"": {},
    "@import \"../components/control-ui/styles/skin.css\"": {},
    "@import \"../components/control-ui/styles/modern-apple-controls.css\"": {},
    "@import \"../components/control-ui/styles/modern-apple-surfaces.css\"": {}
  },
  "meta": {
    "sourceManifestPath": "registry/modern-apple/skin.json"
  }
}
