NEXT_PUBLIC_REGISTRY_URL=http://127.0.0.1:3000
# Set this only when the canonical production host differs from the Vercel production URL.
NEXT_PUBLIC_SITE_URL=https://your-production-domain.example

# Optional ownership verification tokens from Google Search Console and Bing Webmaster Tools.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Theme generator agent. Unset disables the generator with a 503; the prepaid DeepSeek balance is the
# hard spend ceiling, since the API has no configurable per-key limit.
DEEPSEEK_API_KEY=
