      "defaultValue": "var(--primary)"
    },
    {
      "name": "--cui-dropzone-reject-border-color",
      "syntax": "<color>",
      "initialValue": "transparent",
      "defaultValue": "var(--destructive)"
    },
    {
      "name": "--cui-dropzone-overlay-background",
      "syntax": "<color>",
      "initialValue": "transparent",
      "defaultValue": "oklch(from var(--card) l c h / 0.95)"
