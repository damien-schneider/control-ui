{
  "version": 1,
  "family": "badge",
  "selectorPattern": "[data-skin=\"{skin}\"] :where([data-slot=\"{part}\"][data-control-family=\"{family}\"])",
  "registryItems": [
    "badge",
    "source-badge"
  ],
  "knobs": [
    {
      "name": "--cui-badge-icon",
      "syntax": "<length>",
      "initialValue": "0px",
      "defaultValue": "calc(var(--spacing) * 3)"
    },
    {
      "name": "--cui-badge-radius",
      "syntax": "<length-percentage>",
      "initialValue": "0px",
      "defaultValue": "var(--radius-control)"
    },
    {
      "name": "--cui-badge-background",
      "syntax": "<color>",
      "initialValue": "transparent",
      "defaultValue": "var(--_badge-color-background)"
    },
    {
      "name": "--cui-badge-foreground",
      "syntax": "<color>",
      "initialValue": "transparent",
      "defaultValue": "var(--_badge-color-foreground)"
    },
    {
      "name": "--cui-badge-border-color",
      "syntax": "<color>",
      "initialValue": "transparent",
      "defaultValue": "transparent"
    },
    {
      "name": "--cui-badge-border-width",
      "syntax": "<length>",
      "initialValue": "0px",
      "defaultValue": "1px"
    },
    {
      "name": "--cui-badge-font-family",
      "syntax": "*",
      "initialValue": "",
      "defaultValue": "var(--font-body)"
    },
    {
      "name": "--cui-badge-font-size",
      "syntax": "<length-percentage>",
      "initialValue": "0px",
      "defaultValue": "var(--text-caption)"
    },
    {
      "name": "--cui-badge-font-weight",
      "syntax": "<number>",
      "initialValue": "400",
      "defaultValue": "var(--font-weight-medium)"
    }
  ],
  "parts": {
    "badge": {
      "root": {
        "family": "badge",
        "registryItems": [
          "badge"
        ],
        "states": [
          {
            "attribute": "data-color",
            "source": "control-ui",
            "valueKind": "open",
            "values": []
          },
          {
            "attribute": "data-size",
            "source": "control-ui",
            "valueKind": "enum",
            "values": [
              "md",
              "sm"
            ]
          },
          {
            "attribute": "data-variant",
            "source": "control-ui",
            "valueKind": "enum",
            "values": [
              "default",
              "outline"
            ]
          }
        ]
      }
    },
    "source-badge": {
      "root": {
        "family": "badge",
        "registryItems": [
          "source-badge"
        ],
        "states": [
          {
            "attribute": "data-source-badge",
            "source": "control-ui",
            "valueKind": "presence",
            "values": []
          },
          {
            "attribute": "data-source-badge-favicon",
            "source": "control-ui",
            "valueKind": "presence",
            "values": []
          }
        ]
      },
      "label": {
        "registryItems": [
          "source-badge"
        ],
        "states": []
      }
    }
  },
  "adornments": {},
  "uncovered": [],
  "contrast": "/r/contract/badge.contrast.json"
}
