      "defaultValue": "var(--card)"
    },
    {
      "name": "--cui-infinite-canvas-controls-border-color",
      "syntax": "<color>",
      "initialValue": "transparent",
      "defaultValue": "var(--border)"
    },
    {
      "name": "--cui-infinite-canvas-controls-shadow",
      "syntax": "*",
      "initialValue": "",
      "defaultValue": "var(--shadow-sm)"
    }
