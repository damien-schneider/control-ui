          "infinite-canvas"
        ],
        "states": [
          {
            "attribute": "data-scale",
            "source": "control-ui",
            "valueKind": "open",
            "values": []
          }
        ]
      },
      "controls": {
        "family": "infinite-canvas",
        "registryItems": [
          "infinite-canvas"
        ],
        "states": []
      }
    }
  },
  "adornments": {},
  "uncovered": [],
  "contrast": "/r/contract/infinite-canvas.contrast.json"
