{
  "version": 8,
  "family": "activity",
  "selectorPattern": "[data-skin=\"{skin}\"] :where([data-slot=\"{part}\"][data-control-family=\"{family}\"])",
  "registryItems": [
    "activity",
    "chat-layout"
  ],
  "knobs": [
    {
      "name": "--cui-activity-row-foreground",
      "syntax": "<color>",
      "initialValue": "transparent",
      "defaultValue": "var(--muted-foreground)"
    },
    {
      "name": "--cui-activity-trigger-radius",
      "syntax": "<length-percentage>",
      "initialValue": "0px",
      "defaultValue": "var(--radius-control)"
    },
    {
      "name": "--cui-activity-trigger-hover-background",
      "syntax": "<color>",
      "initialValue": "transparent",
      "defaultValue": "oklch(from var(--muted) l c h / 0.45)"
    },
    {
      "name": "--cui-activity-code-background",
      "syntax": "<color>",
      "initialValue": "transparent",
      "defaultValue": "oklch(from var(--muted) l c h / 0.5)"
    }
  ],
  "parts": {
    "activity": {
      "root": {
        "family": "activity",
        "registryItems": [
          "activity"
        ],
        "states": [
          {
            "attribute": "data-activity-kind",
            "source": "control-ui",
            "valueKind": "enum",
            "values": [
              "default",
              "reasoning",
              "signal",
              "tool"
            ]
          },
          {
            "attribute": "data-activity-name",
            "source": "control-ui",
            "valueKind": "open",
            "values": []
          },
          {
            "attribute": "data-activity-state",
