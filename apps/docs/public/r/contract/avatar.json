{
  "version": 1,
  "family": "avatar",
  "selectorPattern": "[data-skin=\"{skin}\"] :where([data-slot=\"{part}\"][data-control-family=\"{family}\"])",
  "registryItems": [
    "avatar"
  ],
  "knobs": [
    {
      "name": "--cui-avatar-size",
      "syntax": "<length-percentage>",
      "initialValue": "0px",
      "defaultValue": "calc(var(--spacing) * 9)"
    },
    {
      "name": "--cui-avatar-radius",
      "syntax": "<length-percentage>",
      "initialValue": "0px",
      "defaultValue": "9999px"
    },
    {
      "name": "--cui-avatar-group-gap",
      "syntax": "<length-percentage>",
      "initialValue": "0px",
      "defaultValue": "calc(var(--spacing) * -2)"
    },
    {
      "name": "--cui-avatar-group-ring-size",
      "syntax": "<length-percentage>",
      "initialValue": "0px",
      "defaultValue": "2px"
    },
    {
      "name": "--cui-avatar-group-ring-color",
      "syntax": "<color>",
      "initialValue": "transparent",
      "defaultValue": "var(--background)"
    },
    {
      "name": "--cui-avatar-fallback-background",
      "syntax": "<color>",
      "initialValue": "transparent",
      "defaultValue": "var(--muted)"
    },
    {
      "name": "--cui-avatar-fallback-foreground",
      "syntax": "<color>",
      "initialValue": "transparent",
      "defaultValue": "var(--muted-foreground)"
    },
    {
      "name": "--cui-avatar-image-outline-color",
      "syntax": "<color>",
      "initialValue": "transparent",
      "defaultValue": "var(--image-outline)"
    },
    {
      "name": "--cui-avatar-badge-size",
      "syntax": "<length-percentage>",
      "initialValue": "0px",
      "defaultValue": "max(0.5rem, 30%)"
    },
    {
      "name": "--cui-avatar-badge-radius",
      "syntax": "<length-percentage>",
      "initialValue": "0px",
      "defaultValue": "9999px"
    },
    {
      "name": "--cui-avatar-badge-ring-size",
      "syntax": "<length-percentage>",
      "initialValue": "0px",
      "defaultValue": "2px"
    },
    {
      "name": "--cui-avatar-badge-ring-color",
      "syntax": "<color>",
      "initialValue": "transparent",
      "defaultValue": "var(--background)"
    },
    {
      "name": "--cui-avatar-badge-background",
      "syntax": "<color>",
      "initialValue": "transparent",
      "defaultValue": "var(--primary)"
    },
    {
      "name": "--cui-avatar-badge-foreground",
      "syntax": "<color>",
      "initialValue": "transparent",
      "defaultValue": "var(--primary-foreground)"
    },
    {
      "name": "--cui-avatar-badge-online-background",
      "syntax": "<color>",
      "initialValue": "transparent",
      "defaultValue": "var(--success)"
    },
    {
      "name": "--cui-avatar-badge-away-background",
      "syntax": "<color>",
      "initialValue": "transparent",
      "defaultValue": "var(--warning)"
    },
    {
      "name": "--cui-avatar-badge-busy-background",
      "syntax": "<color>",
      "initialValue": "transparent",
      "defaultValue": "var(--destructive)"
    },
    {
      "name": "--cui-avatar-badge-offline-background",
      "syntax": "<color>",
      "initialValue": "transparent",
      "defaultValue": "oklch(from var(--muted-foreground) l c h / 0.6)"
    }
  ],
  "parts": {
    "avatar": {
      "root": {
        "family": "avatar",
        "registryItems": [
          "avatar"
        ],
        "states": [
          {
            "attribute": "data-size",
            "source": "control-ui",
            "valueKind": "enum",
            "values": [
              "lg",
              "md",
              "sm",
              "xs"
            ]
          }
        ]
      },
      "badge": {
        "family": "avatar",
        "registryItems": [
          "avatar"
        ],
        "states": [
          {
            "attribute": "data-status",
            "source": "control-ui",
            "valueKind": "enum",
            "values": [
              "away",
              "busy",
              "offline",
              "online"
            ]
          }
        ]
      },
      "fallback": {
        "family": "avatar",
        "registryItems": [
          "avatar"
        ],
        "states": []
      },
      "group": {
        "family": "avatar",
        "registryItems": [
          "avatar"
        ],
        "states": []
      },
      "image": {
        "family": "avatar",
        "registryItems": [
          "avatar"
        ],
        "states": [
          {
            "attribute": "data-ending-style",
            "source": "external",
            "valueKind": "presence",
            "values": []
          },
          {
            "attribute": "data-error",
            "source": "external",
            "valueKind": "presence",
            "values": []
          },
          {
            "attribute": "data-loading",
            "source": "external",
            "valueKind": "presence",
            "values": []
          },
          {
            "attribute": "data-starting-style",
            "source": "external",
            "valueKind": "presence",
            "values": []
          }
        ]
      }
    }
  },
  "adornments": {},
  "uncovered": [],
  "contrast": "/r/contract/avatar.contrast.json"
}
