{
  "version": 1,
  "family": "resize-handle",
  "selectorPattern": "[data-skin=\"{skin}\"] :where([data-slot=\"{part}\"][data-control-family=\"{family}\"])",
  "registryItems": [
    "resize-handle"
  ],
  "knobs": [
    {
      "name": "--cui-resize-handle-size",
      "syntax": "<length>",
      "initialValue": "0px",
      "defaultValue": "10px"
    },
    {
      "name": "--cui-resize-handle-hit-size",
      "syntax": "<length>",
      "initialValue": "0px",
      "defaultValue": "var(--target-min)"
    },
    {
      "name": "--cui-resize-handle-background",
      "syntax": "<color>",
      "initialValue": "transparent",
      "defaultValue": "var(--background)"
    },
    {
      "name": "--cui-resize-handle-hover-background",
      "syntax": "<color>",
      "initialValue": "transparent",
      "defaultValue": "oklch(from var(--primary) l c h / 0.1)"
    },
    {
      "name": "--cui-resize-handle-border-color",
      "syntax": "<color>",
      "initialValue": "transparent",
      "defaultValue": "var(--primary)"
    },
    {
      "name": "--cui-resize-handle-border-width",
      "syntax": "<length>",
      "initialValue": "0px",
      "defaultValue": "var(--control-rim-width)"
    },
    {
      "name": "--cui-resize-handle-radius",
      "syntax": "<length-percentage>",
      "initialValue": "0px",
      "defaultValue": "0px"
    }
  ],
  "parts": {
    "resize-handle": {
      "root": {
        "family": "resize-handle",
        "registryItems": [
          "resize-handle"
        ],
        "states": [
          {
            "attribute": "data-direction",
            "source": "control-ui",
            "valueKind": "enum",
            "values": [
              "e",
              "n",
              "ne",
              "nw",
              "s",
              "se",
              "sw",
              "w"
            ]
          }
        ]
      }
    }
  },
  "adornments": {},
  "uncovered": [
    "--cui-resize-handle-background",
    "--cui-resize-handle-hover-background"
  ],
  "contrast": "/r/contract/resize-handle.contrast.json"
}
