              "system",
              "tool",
              "user"
            ]
          },
          {
            "attribute": "data-streaming",
            "source": "control-ui",
            "valueKind": "presence",
            "values": []
          }
        ]
      },
      "header": {
        "family": "chat-message",
        "registryItems": [
          "chat-message"
        ],
        "states": []
      },
      "row": {
        "family": "chat-message",
        "registryItems": [
          "chat-message"
        ],
        "states": []
      }
    }
  },
  "adornments": {},
  "uncovered": [
    "--cui-chat-message-avatar-background"
  ],
  "contrast": "/r/contract/chat-message.contrast.json"
}
