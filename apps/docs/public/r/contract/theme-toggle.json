{
  "version": 1,
  "family": "theme-toggle",
  "selectorPattern": "[data-skin=\"{skin}\"] :where([data-slot=\"{part}\"][data-control-family=\"{family}\"])",
  "registryItems": [
    "theme-toggle-block"
  ],
  "knobs": [
    {
      "name": "--cui-theme-toggle-height",
