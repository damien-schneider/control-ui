{
  "version": 1,
  "family": "item",
  "anatomies": [
    [
      {
        "attributes": {
          "data-control-family": "sidebar",
          "data-control-ui": "sidebar",
          "data-slot": "wrapper"
        }
      },
      {
        "attributes": {
          "data-control-family": "sidebar",
          "data-control-ui": "sidebar",
          "data-slot": "inset",
          "tabindex": "-1"
        }
      },
      {
        "attributes": {
          "data-control-family": "page-layout",
          "data-control-ui": "page-layout",
          "data-scroll": "inset",
          "data-slot": "root",
          "data-width": "prose"
        }
      },
      {
        "attributes": {
          "data-control-family": "item",
          "data-control-ui": "item",
          "data-slot": "root",
          "data-variant": "muted",
          "href": "#"
        }
      }
    ]
  ],
  "probes": [
    {
      "knobs": {
        "boundary": "--cui-item-hover-border-color",
        "fill": "--cui-item-hover-background"
      },
      "anatomy": 0,
      "rendersText": true,
      "state": true
    }
  ]
}
