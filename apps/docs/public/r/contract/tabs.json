      "syntax": "<length-percentage>",
      "initialValue": "0px",
      "defaultValue": "var(--radius-control)"
    },
    {
      "name": "--cui-tabs-list-padding",
      "syntax": "<length-percentage>",
      "initialValue": "0px",
      "defaultValue": "calc(var(--spacing) * 1)"
