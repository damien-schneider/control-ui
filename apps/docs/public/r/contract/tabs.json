    {
      "name": "--cui-tabs-list-radius",
      "syntax": "<length-percentage>",
      "initialValue": "0px",
      "defaultValue": "calc(\n      var(--cui-tabs-trigger-radius) +\n      clamp(0px, calc(var(--cui-tabs-trigger-radius) * 1000), var(--cui-tabs-list-padding))\n    )"
    },
    {
