{
  "version": 9,
  "family": "chat-layout",
  "selectorPattern": "[data-skin=\"{skin}\"] :where([data-slot=\"{part}\"][data-control-family=\"{family}\"])",
  "registryItems": [
    "chat-layout"
  ],
  "knobs": [
    {
      "name": "--cui-chat-layout-radius",
      "syntax": "<length-percentage>",
      "initialValue": "0px",
      "defaultValue": "var(--radius-scene)"
    },
    {
      "name": "--cui-chat-layout-background",
      "syntax": "<color>",
      "initialValue": "transparent",
      "defaultValue": "var(--background)"
    },
    {
      "name": "--cui-chat-layout-border-color",
      "syntax": "<color>",
      "initialValue": "transparent",
      "defaultValue": "var(--border)"
    },
    {
      "name": "--cui-chat-layout-shadow",
      "syntax": "*",
      "initialValue": "",
      "defaultValue": "var(--shadow-md)"
    }
  ],
  "parts": {
    "chat-layout": {
      "root": {
        "family": "chat-layout",
        "registryItems": [
          "chat-layout"
        ],
        "states": [
          {
            "attribute": "data-chrome",
            "source": "control-ui",
            "valueKind": "enum",
            "values": [
              "embedded",
              "panel"
            ]
          }
        ]
      }
    },
    "chat-thread": {
      "root": {
        "family": "chat-layout",
        "registryItems": [
          "chat-layout"
        ],
        "states": [
          {
            "attribute": "data-chat-layout-kind",
            "source": "control-ui",
            "valueKind": "enum",
            "values": [
              "thread"
            ]
          }
        ]
      },
      "dock": {
        "family": "chat-layout",
        "registryItems": [
          "chat-layout"
        ],
        "states": []
      },
      "thread-content": {
        "family": "chat-layout",
        "registryItems": [
          "chat-layout"
        ],
        "states": []
      }
    },
    "chat-turn": {
      "turn": {
        "family": "chat-layout",
        "registryItems": [
          "chat-layout"
        ],
        "states": [
          {
            "attribute": "data-from",
            "source": "control-ui",
            "valueKind": "enum",
            "values": [
              "assistant",
              "user"
            ]
          }
        ]
      }
    }
  },
  "adornments": {},
  "uncovered": [],
  "contrast": "/r/contract/chat-layout.contrast.json"
}
