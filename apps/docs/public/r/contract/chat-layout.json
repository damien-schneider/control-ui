{
  "version": 1,
  "family": "chat-layout",
  "selectorPattern": "[data-skin=\"{skin}\"] :where([data-slot=\"{part}\"][data-control-family=\"{family}\"])",
  "registryItems": [
    "chat-layout"
  ],
  "knobs": [
    {
      "name": "--cui-chat-layout-radius",
      "syntax": "<length-percentage>",
      "initialValue": "0px",
      "defaultValue": "var(--radius-scene)"
    },
    {
      "name": "--cui-chat-layout-background",
      "syntax": "<color>",
      "initialValue": "transparent",
      "defaultValue": "var(--background)"
    },
    {
      "name": "--cui-chat-layout-border-color",
      "syntax": "<color>",
      "initialValue": "transparent",
      "defaultValue": "var(--border)"
    },
    {
      "name": "--cui-chat-layout-border-width",
      "syntax": "<length>",
      "initialValue": "0px",
      "defaultValue": "var(--control-rim-width)"
    },
    {
      "name": "--cui-chat-layout-shadow",
      "syntax": "*",
      "initialValue": "",
      "defaultValue": "var(--shadow-md)"
    },
    {
      "name": "--cui-chat-layout-gutter-size",
      "syntax": "<length-percentage>",
      "initialValue": "0px",
      "defaultValue": "calc(var(--spacing) * 4)"
    },
    {
      "name": "--cui-chat-layout-column-max-inline-size",
      "syntax": "<length-percentage>",
      "initialValue": "0px",
      "defaultValue": "48rem"
    },
    {
      "name": "--cui-chat-layout-veil-background",
      "syntax": "<color>",
      "initialValue": "transparent",
      "defaultValue": "var(--cui-chat-layout-background)"
    },
    {
      "name": "--cui-chat-layout-veil-backdrop-filter",
      "syntax": "*",
      "initialValue": "",
      "defaultValue": "none"
    },
    {
      "name": "--cui-chat-layout-scroll-button-gap",
      "syntax": "<length-percentage>",
      "initialValue": "0px",
      "defaultValue": "calc(var(--spacing) * 3)"
    },
    {
      "name": "--cui-chat-layout-turn-gap",
      "syntax": "<length-percentage>",
      "initialValue": "0px",
      "defaultValue": "calc(var(--spacing) * 2)"
    }
  ],
  "parts": {
