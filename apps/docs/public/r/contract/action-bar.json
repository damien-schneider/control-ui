{
  "version": 9,
  "family": "action-bar",
  "selectorPattern": "[data-skin=\"{skin}\"] :where([data-slot=\"{part}\"][data-control-family=\"{family}\"])",
  "registryItems": [
    "action-bar"
  ],
  "knobs": [
    {
      "name": "--cui-action-bar-hidden-opacity",
      "syntax": "<number>",
      "initialValue": "0",
      "defaultValue": "0"
    },
    {
      "name": "--cui-action-bar-visible-opacity",
      "syntax": "<number>",
      "initialValue": "1",
      "defaultValue": "1"
    }
  ],
  "parts": {
    "action-bar": {
      "root": {
        "family": "action-bar",
        "registryItems": [
          "action-bar"
        ],
        "states": [
          {
            "attribute": "data-disabled",
            "source": "external",
            "valueKind": "presence",
            "values": []
          },
          {
            "attribute": "data-orientation",
            "source": "external",
            "valueKind": "enum",
            "values": [
              "horizontal",
              "vertical"
            ]
          }
        ]
      }
    }
  },
  "adornments": {},
  "uncovered": [],
  "contrast": "/r/contract/action-bar.contrast.json"
}
