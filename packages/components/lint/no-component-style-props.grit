language js(typescript, jsx)

or {
    or {
      JsxSelfClosingElement(name=$name, attributes=$attributes),
      JsxOpeningElement(name=$name, attributes=$attributes)
    } where {
      $attributes <: some JsxAttribute(name=`style`) as $attr
    },
    JsxAttribute(name=`render`, initializer=JsxAttributeInitializerClause(value=JsxExpressionAttributeValue(expression=$rendered))) as $render where {
      $rendered <: or {
        JsxTagExpression(tag=$tag),
        JsArrowFunctionExpression(body=or {
          or { JsxTagExpression(tag=$tag), JsParenthesizedExpression(expression=JsxTagExpression(tag=$tag)) },
          JsFunctionBody(statements=some JsReturnStatement(argument=or { JsxTagExpression(tag=$tag), JsParenthesizedExpression(expression=JsxTagExpression(tag=$tag)) }))
        })
      },
      $tag <: or {
        JsxSelfClosingElement(name=$renderedName, attributes=$renderedAttributes),
        JsxElement(opening_element=JsxOpeningElement(name=$renderedName, attributes=$renderedAttributes))
      },
      $renderedAttributes <: some JsxAttribute(name=`style`) as $attr,
      $render <: within or { JsxSelfClosingElement(name=$name), JsxOpeningElement(name=$name) },
      $render <: within JsModule() as $module,
      $renderedName <: r"([^.]+).*"($renderedComponent),
      not $module <: contains JsImport() as $importRendered where {
    $importRendered <: r"(?s).*(?:from\s+['\"](?:(?:@ctrl-ui/react|[^'\"]*components/control-ui)/)).*",
    $importRendered <: contains JsIdentifierBinding() as $bindingRendered where { $bindingRendered <: $renderedComponent }
  }
    }
  } where {
    $name <: r"([A-Z]\w*)(?:\.[\w.]+)?"($component),
    $attr <: within JsModule() as $module,
    $attr <: or {
    contains or { JsPropertyObjectMember(name=$attrKey), JsShorthandPropertyObjectMember(name=$attrKey) } where { $attrKey <: r"[\"']?(?:(?:padding|background|color|font|lineHeight|letterSpacing|border|outline|boxShadow|textShadow|textDecoration|textUnderline|textTransform|opacity|filter|backdropFilter|fill|stroke|caretColor|accentColor|mask|WebkitMask|WebkitFontSmoothing|MozOsxFontSmoothing)(?:[A-Z]\w*)?|(?:padding|background|color|font|line-height|letter-spacing|border|outline|box-shadow|text-shadow|text-decoration|text-underline|text-transform|opacity|filter|backdrop-filter|fill|stroke|caret-color|accent-color|mask|-webkit-mask|-webkit-font-smoothing|-moz-osx-font-smoothing)(?:-[\w-]*)?)[\"']?" },
    contains JsReferenceIdentifier() as $attrConstant where {
      $attrConstant <: r"(.+)"($attrConstantName),
      $module <: contains JsVariableDeclaration(declarators=$attrConstantDeclarators) as $attrConstantDeclaration where {
        $attrConstantDeclaration <: r"(?s)const\s.*",
        $attrConstantDeclarators <: some JsVariableDeclarator(id=$attrConstantName, initializer=JsInitializerClause(expression=$attrConstantValue)),
        $attrConstantValue <: or { JsObjectExpression(), TsAsExpression(expression=JsObjectExpression()), TsSatisfiesExpression(expression=JsObjectExpression()) },
        $attrConstantValue <: contains or { JsPropertyObjectMember(name=$attrConstantKey), JsShorthandPropertyObjectMember(name=$attrConstantKey) } where { $attrConstantKey <: r"[\"']?(?:(?:padding|background|color|font|lineHeight|letterSpacing|border|outline|boxShadow|textShadow|textDecoration|textUnderline|textTransform|opacity|filter|backdropFilter|fill|stroke|caretColor|accentColor|mask|WebkitMask|WebkitFontSmoothing|MozOsxFontSmoothing)(?:[A-Z]\w*)?|(?:padding|background|color|font|line-height|letter-spacing|border|outline|box-shadow|text-shadow|text-decoration|text-underline|text-transform|opacity|filter|backdrop-filter|fill|stroke|caret-color|accent-color|mask|-webkit-mask|-webkit-font-smoothing|-moz-osx-font-smoothing)(?:-[\w-]*)?)[\"']?" }
      }
    }
  },
    $module <: contains JsImport() as $import where {
    $import <: r"(?s).*(?:from\s+['\"](?:(?:@ctrl-ui/react|[^'\"]*components/control-ui)/)).*",
    $import <: contains JsIdentifierBinding() as $binding where { $binding <: $component }
  },
    register_diagnostic(span=$attr, message="Control UI component painted through style: color, type, padding, borders, radius, shadows and opacity belong to the component. Set a --cui-* knob in style or use its props; keep other style keys for layout.", severity="error")
  }
