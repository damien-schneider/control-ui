language js(typescript, jsx)

JsxAttribute(name=$name, initializer=$value) as $attr where {
  $name <: `className`,
  $value <: contains r".*\btext-(?:micro|caption|label|body|body-lg|heading-[1-4]|display)\b.*",
  register_diagnostic(span=$attr, message="Type rung in className: render text through <Text>/<Heading>, or size the control with its size prop or --cui-*-font-size knob.", severity="warn")
}
