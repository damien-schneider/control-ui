{
  "name": "@ctrl-ui/react",
  "version": "0.12.3",
  "description": "100+ React components for Tailwind CSS and shadcn/ui: pickers, trees, editors, canvases, app templates, and AI chat surfaces, with neutral defaults and consumer-owned themes.",
  "keywords": [
    "react",
    "react-components",
    "component-library",
    "ui-components",
    "shadcn",
    "shadcn-ui",
    "tailwindcss",
    "design-system",
    "base-ui",
    "nextjs",
    "color-picker",
    "emoji-picker",
    "tree-view",
    "markdown-editor",
    "ai-chat",
    "chat-ui"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/damien-schneider/control-ui.git",
    "directory": "packages/components"
  },
  "homepage": "https://control-ui.dev",
  "type": "module",
  "bin": {
    "control-ui-grit": "./lint/write-grit-rules.mjs"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "lint/*.grit",
    "lint/*.mjs",
    "lint/biome-preset.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./package.json": "./package.json",
    "./styles/*": "./dist/styles/*",
    "./docs/*": "./dist/docs/*",
    "./eslint-plugin": "./lint/eslint-plugin.mjs",
    "./biome": "./lint/biome-preset.json",
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "bun registry-closure.ts && tsdown",
    "typecheck": "tsc -p tsconfig.checks.json",
    "validate": "bun test",
    "lint": "biome lint ."
  },
  "peerDependencies": {
    "@base-ui/react": "^1.9.0",
