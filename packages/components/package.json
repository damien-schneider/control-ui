{
  "name": "@ctrl-ui/react",
  "version": "0.8.6",
  "description": "Control UI components, blocks, and primitives with neutral defaults and consumer-owned themes.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/damien-schneider/control-ui.git",
    "directory": "packages/components"
  },
  "homepage": "https://control-ui.dev",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./package.json": "./package.json",
    "./styles/*": "./dist/styles/*",
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "bun registry-closure.ts && tsdown",
    "typecheck": "tsc -p tsconfig.checks.json",
    "validate": "bun test",
    "lint": "biome lint ."
  },
